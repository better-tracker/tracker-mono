# Local development examples only; never use these credentials in production.
PORT=3001
POSTGRES_USER=project_tracker
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=project_tracker
DATABASE_URL=postgresql://project_tracker:local_dev_only@localhost:5432/project_tracker
VITE_API_URL=http://localhost:3001
# Physical devices need your computer's LAN IP; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
# Optional: start the Redis Compose profile before enabling this setting.
# REDIS_URL=redis://127.0.0.1:6379

AUTH0_DOMAIN=project-tracker-dev.au.auth0.com
AUTH0_AUDIENCE=https://project-tracker-api
